# Copia este archivo como src/.env y pon tus valores reales (src/.env no se sube a GitHub).
JWT_SECRET_KEY=escribe-aqui-una-clave-larga-y-secreta
# Base de datos MySQL. Sin esta variable se usa el MySQL local de XAMPP.
DATABASE_URL=mysql+pymysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?charset=utf8mb4
# Dominios del frontend desplegado que pueden llamar a la API, separados por comas.
CORS_ORIGINS=
