{"info":{"name":"testcases","description":"Pruebas de integración de la API de WoodArt, organizadas por módulo. Requisitos: MySQL encendido, backend en http://127.0.0.1:5000 y registro de usuarios abierto.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"Usuarios","description":"Registro, inicio de sesión, perfil y permisos.","item":[{"name":"U01 Registrar cliente con datos válidos","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 201\", () => pm.response.to.have.status(201));","const d = pm.response.json();","pm.test(\"Mensaje de usuario creado\", () => pm.expect(d.message).to.eql(\"Usuario creado exitosamente\"));","pm.test(\"Devuelve el id del usuario\", () => pm.expect(d.usuario.id_usuario).to.be.a(\"number\"));","pm.test(\"El rol asignado es cliente\", () => pm.expect(d.usuario.rol).to.eql(\"cliente\"));","pm.test(\"No devuelve la contraseña\", () => pm.expect(d.usuario).to.not.have.property(\"password\"));"]}},{"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.collectionVariables.set(\"email_usuario\", \"usuario_\" + Date.now() + \"@woodart.test\");"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/usuarios","body":{"mode":"raw","raw":"{\"nombre\": \"Laura\", \"apellido\": \"Pruebas\", \"email\": \"{{email_usuario}}\", \"password\": \"{{clave_qa}}\", \"telefono\": \"3001234567\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"U02 Registrar sin nombre","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 400\", () => pm.response.to.have.status(400));","pm.test(\"Indica que falta el nombre\", () => pm.expect(pm.response.json().error).to.include(\"nombre es obligatorio\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/usuarios","body":{"mode":"raw","raw":"{\"apellido\": \"Pruebas\", \"email\": \"sin_nombre@woodart.test\", \"password\": \"{{clave_qa}}\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"U03 Registrar sin contraseña","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 400\", () => pm.response.to.have.status(400));","pm.test(\"Indica que falta la contraseña\", () => pm.expect(pm.response.json().error).to.include(\"contraseña es obligatoria\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/usuarios","body":{"mode":"raw","raw":"{\"nombre\": \"Laura\", \"apellido\": \"Pruebas\", \"email\": \"sin_clave@woodart.test\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"U04 Registrar con correo repetido","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 409\", () => pm.response.to.have.status(409));","pm.test(\"Avisa que el correo existe\", () => pm.expect(pm.response.json().error).to.include(\"ya está registrado\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/usuarios","body":{"mode":"raw","raw":"{\"nombre\": \"Otra\", \"apellido\": \"Persona\", \"email\": \"{{email_usuario}}\", \"password\": \"{{clave_qa}}\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"U05 Registrar pidiendo rol admin","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 201\", () => pm.response.to.have.status(201));","pm.test(\"La API ignora el rol y crea un cliente\", () => pm.expect(pm.response.json().usuario.rol).to.eql(\"cliente\"));"]}},{"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.collectionVariables.set(\"email_admin\", \"intento_admin_\" + Date.now() + \"@woodart.test\");"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/usuarios","body":{"mode":"raw","raw":"{\"nombre\": \"Intento\", \"apellido\": \"Admin\", \"email\": \"{{email_admin}}\", \"password\": \"{{clave_qa}}\", \"rol\": \"admin\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"U06 Iniciar sesión con datos correctos","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","const d = pm.response.json();","pm.test(\"Mensaje de inicio exitoso\", () => pm.expect(d.message).to.eql(\"Inicio de sesión exitoso\"));","pm.test(\"Entrega un token JWT de 3 partes\", () => pm.expect(d.access_token.split(\".\")).to.have.lengthOf(3));","pm.test(\"Devuelve el usuario correcto\", () => pm.expect(d.usuario.email).to.eql(pm.collectionVariables.get(\"email_usuario\")));","pm.collectionVariables.set(\"token_usuario\", d.access_token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/usuarios/login","body":{"mode":"raw","raw":"{\"email\": \"{{email_usuario}}\", \"password\": \"{{clave_qa}}\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"U07 Iniciar sesión con correo en mayúsculas","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","pm.test(\"Acepta el correo sin importar mayúsculas ni espacios\", () => pm.expect(pm.response.json().access_token).to.be.a(\"string\"));"]}},{"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.collectionVariables.set(\"email_mayus\", \"  \" + pm.collectionVariables.get(\"email_usuario\").toUpperCase() + \" \");"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/usuarios/login","body":{"mode":"raw","raw":"{\"email\": \"{{email_mayus}}\", \"password\": \"{{clave_qa}}\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"U08 Iniciar sesión con contraseña incorrecta","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 401\", () => pm.response.to.have.status(401));","pm.test(\"Rechaza las credenciales\", () => pm.expect(pm.response.json().error).to.include(\"Credenciales incorrectas\"));","pm.test(\"No entrega token\", () => pm.expect(pm.response.json()).to.not.have.property(\"access_token\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/usuarios/login","body":{"mode":"raw","raw":"{\"email\": \"{{email_usuario}}\", \"password\": \"ClaveEquivocada1\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"U09 Iniciar sesión con correo no registrado","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 401\", () => pm.response.to.have.status(401));","pm.test(\"Usa el mismo mensaje que con la contraseña incorrecta\", () => pm.expect(pm.response.json().error).to.include(\"Credenciales incorrectas\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/usuarios/login","body":{"mode":"raw","raw":"{\"email\": \"no_existe_{{$timestamp}}@woodart.test\", \"password\": \"{{clave_qa}}\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"U10 Iniciar sesión sin contraseña","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 400\", () => pm.response.to.have.status(400));","pm.test(\"Pide correo y contraseña\", () => pm.expect(pm.response.json().error).to.include(\"obligatorios\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/usuarios/login","body":{"mode":"raw","raw":"{\"email\": \"{{email_usuario}}\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"U11 Ver perfil con token","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","const d = pm.response.json();","pm.test(\"El token es válido\", () => pm.expect(d.message).to.eql(\"Token válido\"));","pm.test(\"El perfil es del usuario que inició sesión\", () => pm.expect(d.usuario.email).to.eql(pm.collectionVariables.get(\"email_usuario\")));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/usuarios/perfil","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_usuario}}","type":"string"}]}}},{"name":"U12 Ver perfil sin token","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 401\", () => pm.response.to.have.status(401));","pm.test(\"Pide el token\", () => pm.expect(pm.response.json().error).to.include(\"Token faltante\"));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/usuarios/perfil","auth":{"type":"noauth"}}},{"name":"U13 Ver perfil con token inválido","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 401\", () => pm.response.to.have.status(401));","pm.test(\"Rechaza el token alterado\", () => pm.expect(pm.response.json().error).to.include(\"Token inválido\"));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/usuarios/perfil","auth":{"type":"bearer","bearer":[{"key":"token","value":"token.alterado.123","type":"string"}]}}},{"name":"U14 Listar usuarios con rol cliente","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 403\", () => pm.response.to.have.status(403));","pm.test(\"Solo el administrador puede listar usuarios\", () => pm.expect(pm.response.json().error).to.include(\"No tienes permisos\"));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/usuarios/","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_usuario}}","type":"string"}]}}}]},{"name":"Productos","description":"Catálogo, paginación, filtros, búsqueda y permisos de administración.","item":[{"name":"P01 Listar la primera página","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","const d = pm.response.json();","pm.test(\"Trae una lista de productos\", () => pm.expect(d.productos).to.be.an(\"array\").that.is.not.empty);","pm.test(\"Por defecto muestra 8 por página\", () => { pm.expect(d.por_pagina).to.eql(8); pm.expect(d.productos.length).to.be.at.most(8); });","pm.test(\"Incluye los datos de paginación\", () => pm.expect(d).to.include.keys(\"pagina\", \"total_productos\", \"total_paginas\"));","pm.test(\"Cada producto tiene nombre, precio y categoría\", () => d.productos.forEach(p => pm.expect(p).to.include.keys(\"id\", \"nombre\", \"precio\", \"id_categoria\")));","pm.collectionVariables.set(\"id_producto\", d.productos[0].id);"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/productos","auth":{"type":"noauth"}}},{"name":"P02 Paginar de 3 en 3","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","const d = pm.response.json();","pm.test(\"Respeta la página pedida\", () => pm.expect(d.pagina).to.eql(2));","pm.test(\"Máximo 3 productos\", () => pm.expect(d.productos.length).to.be.at.most(3));","pm.test(\"Calcula bien el total de páginas\", () => pm.expect(d.total_paginas).to.eql(Math.ceil(d.total_productos / 3)));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/productos?page=2&per_page=3","auth":{"type":"noauth"}}},{"name":"P03 Página inválida vuelve a la 1","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","pm.test(\"Corrige la página a 1\", () => pm.expect(pm.response.json().pagina).to.eql(1));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/productos?page=-5","auth":{"type":"noauth"}}},{"name":"P04 Filtrar por categoría Muebles","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","const d = pm.response.json();","pm.test(\"Todos son de la categoría 2\", () => d.productos.forEach(p => pm.expect(p.id_categoria).to.eql(2)));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/productos?id_categoria=2&per_page=50","auth":{"type":"noauth"}}},{"name":"P05 Buscar la palabra madera","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","const d = pm.response.json();","pm.test(\"Devuelve el término buscado\", () => pm.expect(d.busqueda).to.eql(\"madera\"));","pm.test(\"Cada resultado contiene la palabra\", () => d.productos.forEach(p => {","  const texto = [p.nombre, p.descripcion, p.material, p.color].join(\" \").toLowerCase();","  pm.expect(texto).to.include(\"madera\");","}));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/productos?q=madera&per_page=50","auth":{"type":"noauth"}}},{"name":"P06 Buscar sin resultados","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","const d = pm.response.json();","pm.test(\"No encuentra productos\", () => { pm.expect(d.productos).to.be.empty; pm.expect(d.total_productos).to.eql(0); });"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/productos?q=zzxqwy","auth":{"type":"noauth"}}},{"name":"P07 Ver un producto por id","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","const d = pm.response.json();","pm.test(\"Es el producto pedido\", () => pm.expect(d.id).to.eql(Number(pm.collectionVariables.get(\"id_producto\"))));","pm.test(\"El precio es un número mayor que 0\", () => pm.expect(Number(d.precio)).to.be.above(0));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/productos/{{id_producto}}","auth":{"type":"noauth"}}},{"name":"P08 Ver un producto que no existe","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 404\", () => pm.response.to.have.status(404));","pm.test(\"Indica que no existe\", () => pm.expect(pm.response.json().error).to.include(\"Producto no encontrado\"));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/productos/999999","auth":{"type":"noauth"}}},{"name":"P09 Crear producto sin token","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 401\", () => pm.response.to.have.status(401));","pm.test(\"Pide el token\", () => pm.expect(pm.response.json().error).to.include(\"Token\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/productos","body":{"mode":"raw","raw":"{\"nombre\": \"Silla de prueba\", \"precio\": 10000, \"id_categoria\": 2}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"P10 Crear producto con rol cliente","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 403\", () => pm.response.to.have.status(403));","pm.test(\"Solo el administrador crea productos\", () => pm.expect(pm.response.json().error).to.include(\"No tienes permisos\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/productos","body":{"mode":"raw","raw":"{\"nombre\": \"Silla de prueba\", \"precio\": 10000, \"id_categoria\": 2}","options":{"raw":{"language":"json"}}},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}},{"name":"P11 Editar producto con rol cliente","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 403\", () => pm.response.to.have.status(403));","pm.test(\"Solo el administrador edita productos\", () => pm.expect(pm.response.json().error).to.include(\"No tienes permisos\"));"]}}],"request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/productos/{{id_producto}}","body":{"mode":"raw","raw":"{\"precio\": 1}","options":{"raw":{"language":"json"}}},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}},{"name":"P12 Eliminar producto con rol cliente","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 403\", () => pm.response.to.have.status(403));","pm.test(\"Solo el administrador elimina productos\", () => pm.expect(pm.response.json().error).to.include(\"No tienes permisos\"));"]}}],"request":{"method":"DELETE","header":[],"url":"{{base_url}}/productos/{{id_producto}}","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}}]},{"name":"Carrito","description":"Agregar, consultar y quitar productos del carrito, con control de acceso.","item":[{"name":"C01 Ver carrito vacío","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","pm.test(\"El carrito empieza vacío\", () => pm.expect(pm.response.json()).to.be.an(\"array\").that.is.empty);"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/carrito?id_usuario={{id_cliente}}","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}},{"name":"C02 Agregar sin token","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 401\", () => pm.response.to.have.status(401));","pm.test(\"Pide el token\", () => pm.expect(pm.response.json().error).to.include(\"Token\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/carrito","body":{"mode":"raw","raw":"{\"id_usuario\": {{id_cliente}}, \"id_producto\": {{id_producto}}, \"cantidad\": 1}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}}},{"name":"C03 Agregar con token inválido","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 401\", () => pm.response.to.have.status(401));","pm.test(\"Rechaza el token alterado\", () => pm.expect(pm.response.json().error).to.include(\"Token inválido\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/carrito","body":{"mode":"raw","raw":"{\"id_usuario\": {{id_cliente}}, \"id_producto\": {{id_producto}}, \"cantidad\": 1}","options":{"raw":{"language":"json"}}},"auth":{"type":"bearer","bearer":[{"key":"token","value":"token.alterado.123","type":"string"}]}}},{"name":"C04 Agregar sin indicar el producto","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 400\", () => pm.response.to.have.status(400));","pm.test(\"Pide el producto\", () => pm.expect(pm.response.json().error).to.include(\"Producto no especificado\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/carrito","body":{"mode":"raw","raw":"{\"id_usuario\": {{id_cliente}}, \"cantidad\": 1}","options":{"raw":{"language":"json"}}},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}},{"name":"C05 Agregar 2 unidades de un producto","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 201\", () => pm.response.to.have.status(201));","pm.test(\"Producto agregado\", () => pm.expect(pm.response.json().message).to.eql(\"Producto agregado al carrito\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/carrito","body":{"mode":"raw","raw":"{\"id_usuario\": {{id_cliente}}, \"id_producto\": {{id_producto}}, \"cantidad\": 2}","options":{"raw":{"language":"json"}}},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}},{"name":"C06 Agregar 1 unidad más del mismo producto","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 201\", () => pm.response.to.have.status(201));","pm.test(\"Producto agregado\", () => pm.expect(pm.response.json().message).to.eql(\"Producto agregado al carrito\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/carrito","body":{"mode":"raw","raw":"{\"id_usuario\": {{id_cliente}}, \"id_producto\": {{id_producto}}, \"cantidad\": 1}","options":{"raw":{"language":"json"}}},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}},{"name":"C07 Ver carrito con el producto","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","const items = pm.response.json();","const item = items.find(i => i.id_producto == pm.collectionVariables.get(\"id_producto\"));","pm.test(\"El producto está en el carrito\", () => pm.expect(item).to.exist);","pm.test(\"No duplica la línea: suma las cantidades (2 + 1 = 3)\", () => { pm.expect(items.length).to.eql(1); pm.expect(item.cantidad).to.eql(3); });","pm.test(\"El subtotal es precio x cantidad\", () => pm.expect(Number(item.subtotal)).to.be.closeTo(Number(item.precio) * item.cantidad, 0.01));","pm.collectionVariables.set(\"id_carrito\", item.id_carrito);"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/carrito?id_usuario={{id_cliente}}","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}},{"name":"C08 Ver carrito sin token","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 401\", () => pm.response.to.have.status(401));","pm.test(\"Pide el token\", () => pm.expect(pm.response.json().error).to.include(\"Token\"));"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/carrito?id_usuario={{id_cliente}}","auth":{"type":"noauth"}}},{"name":"C09 Quitar producto del carrito ajeno","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 404\", () => pm.response.to.have.status(404));","pm.test(\"No deja borrar el carrito de otro usuario\", () => pm.expect(pm.response.json().error).to.include(\"no está en tu carrito\"));"]}},{"listen":"prerequest","script":{"type":"text/javascript","exec":["const base = pm.collectionVariables.get(\"base_url\");","const email = \"otro_\" + Date.now() + \"@woodart.test\";","const clave = pm.collectionVariables.get(\"clave_qa\");","const json = (obj) => ({ mode: \"raw\", raw: JSON.stringify(obj) });","const h = [{ key: \"Content-Type\", value: \"application/json\" }];","pm.sendRequest({ url: base + \"/usuarios\", method: \"POST\", header: h, body: json({ nombre: \"Otro\", apellido: \"Cliente\", email, password: clave }) }, () => {","  pm.sendRequest({ url: base + \"/usuarios/login\", method: \"POST\", header: h, body: json({ email, password: clave }) }, (err, res) => {","    pm.collectionVariables.set(\"token_otro\", res.json().access_token);","  });","});"]}}],"request":{"method":"DELETE","header":[],"url":"{{base_url}}/carrito/{{id_carrito}}","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_otro}}","type":"string"}]}}},{"name":"C10 Quitar producto del carrito","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","pm.test(\"Producto eliminado\", () => pm.expect(pm.response.json().message).to.eql(\"Producto eliminado del carrito\"));"]}}],"request":{"method":"DELETE","header":[],"url":"{{base_url}}/carrito/{{id_carrito}}","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}},{"name":"C11 Quitar el mismo producto otra vez","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 404\", () => pm.response.to.have.status(404));","pm.test(\"Ya no existe\", () => pm.expect(pm.response.json().error).to.include(\"no está en tu carrito\"));"]}}],"request":{"method":"DELETE","header":[],"url":"{{base_url}}/carrito/{{id_carrito}}","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}},{"name":"C12 Ver carrito después de quitar","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Responde 200\", () => pm.response.to.have.status(200));","pm.test(\"El carrito quedó vacío\", () => pm.expect(pm.response.json()).to.be.empty);"]}}],"request":{"method":"GET","header":[],"url":"{{base_url}}/carrito?id_usuario={{id_cliente}}","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_cliente}}","type":"string"}]}}}]}],"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["// Prepara un cliente de pruebas (token_cliente) y un producto (id_producto)","// para que cada carpeta se pueda ejecutar sola.","const base = pm.collectionVariables.get(\"base_url\");","const clave = pm.collectionVariables.get(\"clave_qa\");","const hora = Number(pm.collectionVariables.get(\"token_hora\") || 0);","const json = (obj) => ({ mode: \"raw\", raw: JSON.stringify(obj) });","const h = [{ key: \"Content-Type\", value: \"application/json\" }];","if (!pm.collectionVariables.get(\"token_cliente\") || Date.now() - hora > 60 * 60 * 1000) {","  const email = \"cliente_\" + Date.now() + \"@woodart.test\";","  pm.sendRequest({ url: base + \"/usuarios\", method: \"POST\", header: h, body: json({ nombre: \"Cliente\", apellido: \"Pruebas\", email, password: clave }) }, () => {","    pm.sendRequest({ url: base + \"/usuarios/login\", method: \"POST\", header: h, body: json({ email, password: clave }) }, (err, res) => {","      const d = res.json();","      pm.collectionVariables.set(\"token_cliente\", d.access_token);","      pm.collectionVariables.set(\"id_cliente\", d.usuario.id_usuario);","      pm.collectionVariables.set(\"token_hora\", Date.now());","    });","  });","}","if (!pm.collectionVariables.get(\"id_producto\")) {","  pm.sendRequest(base + \"/productos?per_page=1\", (err, res) => {","    pm.collectionVariables.set(\"id_producto\", res.json().productos[0].id);","  });","}"]}}],"variable":[{"key":"base_url","value":"http://127.0.0.1:5000/api/v1"},{"key":"clave_qa","value":"Pruebas2026*"},{"key":"email_usuario","value":""},{"key":"email_admin","value":""},{"key":"email_mayus","value":""},{"key":"token_usuario","value":""},{"key":"token_cliente","value":""},{"key":"id_cliente","value":""},{"key":"token_hora","value":""},{"key":"id_producto","value":""},{"key":"id_carrito","value":""},{"key":"token_otro","value":""}]}